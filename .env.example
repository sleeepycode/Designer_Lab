# Скопируйте в .env (.env в git не попадает)

# SQLite — файл в корне проекта, сервер PostgreSQL не нужен
database_url=sqlite:///./lab_formatter.db

cors_origins=http://localhost:3000,http://127.0.0.1:3000

backend_public_url=http://127.0.0.1:8002
doc_service_base_url=http://127.0.0.1:8000
ml_service_base_url=http://127.0.0.1:8001
doc_service_timeout=900
ml_timeout=900

auth_secret_key=change-me-in-production

# PostgreSQL (если понадобится на сервере):
# database_url=postgresql+psycopg://postgres:PASSWORD@localhost:5432/lab_formatter
# pip install psycopg[binary] && alembic upgrade head
