# Document Processing Service Configuration

# FastAPI
APP_NAME=Document Processing Service
DEBUG=True
PORT=8001

# Celery with SQLAlchemy backend (no Redis needed!)
CELERY_BROKER_URL=sqla+sqlite:///./celery_broker.db
CELERY_RESULT_BACKEND=db+sqlite:///./celery_results.db

# API Authentication
API_KEY=your-super-secret-api-key-change-this

# Main Backend
MAIN_BACKEND_URL=http://localhost:8000

# Storage
STORAGE_DIR=storage
INPUT_DIR=storage/inputs
OUTPUT_DIR=storage/outputs
REPORT_DIR=storage/reports

# GOST Formatting
UNIVERSITY_NAME=МИНИСТЕРСТВО ЦИФРОВОГО РАЗВИТИЯ, СВЯЗИ И МАССОВЫХ КОММУНИКАЦИЙ РОССИЙСКОЙ ФЕДЕРАЦИИ
Ордена трудового Красного Знамени федеральное государственное бюджетное
образовательное учреждение высшего образования
«Московский технический университет связи и информатики»
CITY=Москва
YEAR=2026
FONT_NAME=Times New Roman
FONT_SIZE_PT=14.0
LINE_SPACING=1.5
FIRST_LINE_INDENT_CM=1.25
MARGIN_LEFT_CM=3.0
MARGIN_RIGHT_CM=1.5
MARGIN_TOP_CM=2.0
MARGIN_BOTTOM_CM=2.0
