# Скопируйте в .env и подставьте свои значения (.env в git не попадает)

database_url=postgresql+psycopg://postgres:postgres@localhost:5432/lab_formatter
cors_origins=http://localhost:3000,http://127.0.0.1:3000

# Backend №1 — порт uvicorn (обычно 8002 локально)
backend_public_url=http://127.0.0.1:8002

# Внешние сервисы
doc_service_base_url=http://127.0.0.1:8000
ml_service_base_url=http://127.0.0.1:8001
doc_service_timeout=900
ml_timeout=900

auth_secret_key=change-me-in-production
